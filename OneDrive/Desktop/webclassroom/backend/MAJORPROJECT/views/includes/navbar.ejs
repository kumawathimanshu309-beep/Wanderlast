<style>
    .custom-navbar {
        min-height: 76px;
        padding: 10px 24px;
        background: #fff;
    }

    .navbar-brand {
        margin-right: 28px;
        color: #667bf5;
        font-size: 28px;
    }

    .navbar-brand:hover {
        color: #667bf5;
    }

    .navbar-left,
    .navbar-right {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    .navbar-left .nav-link,
    .navbar-right .nav-link {
        padding: 10px 12px;
        color: #484848;
        font-size: 16px;
    }

    .navbar-left .nav-link:hover,
    .navbar-right .nav-link:hover {
        color: #667bf5;
    }

    .navbar-search-wrapper {
        position: absolute;
        left: 50%;
        width: min(620px, 48%);
        transform: translateX(-50%);
    }

    .search-form {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .search-input {
        width: 100%;
        height: 32px;
        padding: 10px 24px;
        border: 1px solid #ddd;
        border-radius: 30px;
        background: #fff;
        font-size: 16px;
        text-align: center;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .search-input:focus {
        border-color: #667bf5;
        box-shadow: 0 0 0 4px rgb(102 123 245 / 20%);
        outline: none;
    }

    .search-input::placeholder {
        color: #666;
        opacity: 1;
    }

    .btn-search {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-width: 150px;
        height: 35px;
        padding: 0 15px;
        border: 1px solid #667bf5;
        border-radius: 50px;
        background: #667bf5;
        color: #fff;
        font-size: 16px;
        white-space: nowrap;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }

    .btn-search:hover {
        border-color: #667bf5;
        background: #667bf5;
        color: #fff;
        transform: translateY(-1px);
    }

    @media (max-width: 991.98px) {
        .custom-navbar {
            padding-right: 16px;
            padding-left: 16px;
        }

        .navbar-brand {
            margin-right: 12px;
        }

        .navbar-search-wrapper {
            width: min(540px, 46%);
        }

        .search-form {
            gap: 8px;
        }

        .btn-search {
            min-width: 110px;
            padding: 0 16px;
        }
    }

    @media (max-width: 767.98px) {
        .custom-navbar {
            padding: 10px 16px;
        }

        .navbar-search-wrapper {
            position: static;
            width: 100%;
            margin: 12px 0;
            transform: none;
        }

        .navbar-search-wrapper .search-form {
            width: 100%;
        }

        .search-input {
            min-width: 0;
            height: 46px;
            padding: 10px 14px;
            flex: 1;
            font-size: 14px;
        }

        .btn-search {
            min-width: 100px;
            height: 46px;
            padding: 0 14px;
            font-size: 14px;
        }

        .navbar-left,
        .navbar-right {
            align-items: stretch;
        }

        .navbar-right {
            margin-left: 0 !important;
        }

        .navbar-left .nav-link,
        .navbar-right .nav-link {
            padding: 10px 4px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .search-input,
        .btn-search {
            transition: none;
        }
    }
</style>

<nav class="navbar navbar-expand-md custom-navbar border-bottom sticky-top">
    <div class="container-fluid position-relative p-0">
        <a class="navbar-brand" href="/listings" aria-label="Home">
            <i class="fa-solid fa-compass" aria-hidden="true"></i>
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav navbar-left">
                <li class="nav-item">
                    <a class="nav-link" href="/listings">Explore</a>
                </li>

               <% if (typeof currUser !== "undefined" && currUser) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/listings/new">
                            Add New Listing
                        </a>
                    </li>
                <% } %>
            </ul>

            <div class="navbar-search-wrapper">
                <form
                    class="search-form"
                    action="/listings"
                    method="GET"
                    role="search"
                >
                    <input
                        class="form-control search-input"
                        type="search"
                        name="search"
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                        placeholder="Search destinations"
                        aria-label="Search destinations"
                    />

                    <button class="btn btn-search" type="submit">
                        <i
                            class="fa-solid fa-magnifying-glass"
                            aria-hidden="true"
                        ></i>
                        <span>Search</span>
                    </button>
                </form>
            </div>

            <ul class="navbar-nav navbar-right ms-auto">
               <% if (typeof currUser === "undefined" || !currUser) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/signup">
                            <b>Signup</b>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/login">
                            <b>Login</b>
                        </a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">
                            <b>Logout</b>
                        </a>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>